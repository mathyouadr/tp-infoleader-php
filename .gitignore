# Secrets et données locales (générés par app/install.php)
storage/config.php
storage/tmp/*
storage/logs/*
!storage/tmp/.gitkeep
!storage/logs/.gitkeep

# Images envoyées depuis l'admin (seul le .htaccess de protection est versionné)
assets/products/uploads/*
!assets/products/uploads/.htaccess

# Dépendances Composer : réinstaller avec « composer install »
vendor/*
!vendor/.htaccess

# Outils locaux
.playwright-mcp/
*.log
